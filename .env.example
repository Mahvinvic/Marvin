# Chat (NVIDIA NIM)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Data store — create a KV database in the Vercel dashboard (Storage tab)
# and connect it to this project; these get filled in automatically for
# both `vercel dev` and production. Only needed manually for other hosts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sign-in with Google, via Clerk (https://dashboard.clerk.com) — create an
# application, enable "Google" under User & Authentication > Social
# Connections, then copy these from API Keys. VITE_CLERK_PUBLISHABLE_KEY is
# shipped to the browser (that's expected — it's a public key);
# CLERK_SECRET_KEY must stay server-side only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Learn tab (YouTube Data API v3) — create an API key at
# https://console.cloud.google.com/apis/credentials with "YouTube Data API
# v3" enabled, then restrict the key to that API. Free tier is 10,000
# quota units/day; each search costs 100 units (~100 searches/day), which
# is why results are cached and only fetched on demand, not automatically.
YOUTUBE_API_KEY=

# Background push notifications (Web Push / VAPID) — generate a keypair
# yourself, no external account needed:
#   npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY is safe to expose to the browser; VAPID_PRIVATE_KEY
# must stay server-side only. VAPID_SUBJECT is a contact URI (mailto: or
# https:) push services may use to reach you about your server's use of push.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any string you choose — protects the cron-triggered endpoint that sends
# habit reminders. Vercel sends this automatically as a Bearer token once
# both this var and the cron job (see vercel.json) are set up.
CRON_SECRET=

# WhatsApp Business Platform (Meta Cloud API) — from your Meta Developer app
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — enter the SAME value when registering the webhook
# URL in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# The name (and language) of your approved "Authentication" category
# message template, used to send the OTP.
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_OTP_TEMPLATE_LANG=en_US
