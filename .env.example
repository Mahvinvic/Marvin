# Chat (NVIDIA NIM)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Data store — create a KV database in the Vercel dashboard (Storage tab)
# and connect it to this project; these get filled in automatically for
# both `vercel dev` and production. Only needed manually for other hosts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Sign-In — create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials, with this app's URL
# added under "Authorized JavaScript origins". Both vars must be the SAME
# client ID; VITE_GOOGLE_CLIENT_ID is the one actually shipped to the browser.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# WhatsApp Business Platform (Meta Cloud API) — from your Meta Developer app
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose — enter the SAME value when registering the webhook
# URL in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# The name (and language) of your approved "Authentication" category
# message template, used to send the OTP.
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_OTP_TEMPLATE_LANG=en_US
